# URL e chave pública (anon) do projeto Supabase — Project Settings > API.
# A chave anon é pública por design; a segurança é garantida pelas políticas RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# "supabase" (produção) ou "demo" (dados locais no navegador, sem login)
VITE_DATA_MODE=supabase

# NUNCA coloque a service_role key aqui. Ela vai apenas nas variáveis da Netlify
# (sem prefixo VITE_), usada pela função serverless de convite de usuários:
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
